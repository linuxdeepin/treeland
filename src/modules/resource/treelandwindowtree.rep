#include <QtCore/QVariant>
#include <QtCore/QRectF>
#include <QtCore/QPointF>

POD WindowInfo(
    qint64 id,
    QString appId,
    QString title,
    QString output,
    QString container,
    int workspace,
    int layer,
    int z,
    int type,
    int state,
    bool visible,
    bool active,
    bool minimized,
    QRectF geometry,
    QRectF titlebarGeometry,
    QRectF boundingRect,
    QRectF iconGeometry,
    QPointF position,
    qint64 frames,
    QRectF damage
)

POD WorkspaceInfo(
    int id,
    bool isActive,
    QList<WindowInfo> windows
)

POD LayerInfo(
    QString name,
    int layer,
    QList<WindowInfo> windows,  // normal layer
    QList<WorkspaceInfo> workspaces // if is workspace
)

POD TreelandInfo(
    QString currentMode,
    QList<LayerInfo> layers
)

// A connected Wayland client (pid 0 when not available) together with the
// toplevel windows it owns. Used by the ``treeland-debug top`` / ``clients``
// commands to present an adb-style overview of the compositor state.
POD ClientInfo(
    qint64 id,
    QString appId,
    int pid,
    QString executable,
    QString command,
    QList<WindowInfo> windows
)

// Real-time debug event: input events, window state changes, etc.
// type: 1=pointerMotion 2=pointerButton 3=keyboardKey 4=focusChanged 5=cursorWindowChanged
POD DebugEvent(
    quint64 seq,
    int type,
    qint64 target,     // target window id, 0 = desktop / no target
    QString detail,    // human-readable description
    quint64 timestampMs
)

// Idle state and one idle-inhibit source, used by the ``treeland-debug idle``
// command. kind is "idle-inhibit" (zwp_idle_inhibit_manager_v1 surface;
// surfaceId/title/heldMs identify it) or "screensaver"
// (treeland_screensaver_v2 inhibit; appName/reason are the client-provided
// strings). active means this source alone counts as inhibiting right now.
POD IdleInhibitor(
    qint64 surfaceId,
    QString kind,
    QString appId,
    QString title,
    int pid,
    QString executable,
    QString command,
    QString appName,
    QString reason,
    bool active,
    quint64 heldMs
)

// Snapshot of the compositor idle state. idleMs is the time since the last
// input activity on any seat; inhibited is whether idle notification is
// currently suppressed (by any source below, or by the screensaver).
POD IdleInfo(
    bool inhibited,
    bool screensaverInhibited,
    quint64 idleMs,
    QList<IdleInhibitor> inhibitors
)

class WindowTreeRemote {
    SLOT(TreelandInfo getTreelandInfo());
    SLOT(QList<WindowInfo> getWindows());
    SLOT(QList<ClientInfo> getClients());
    SLOT(IdleInfo getIdleInfo());
    SLOT(bool activateWindow(qint64 id));
    SLOT(bool closeWindow(qint64 id));
    SLOT(bool minimizeWindow(qint64 id));
    SLOT(bool toggleMaximized(qint64 id));
    SLOT(bool toggleFullscreen(qint64 id));
    SLOT(bool moveWindow(qint64 id, int x, int y));
    SLOT(bool resizeWindow(qint64 id, int w, int h));
    SLOT(bool setWindowWorkspace(qint64 id, int workspaceId));
    SLOT(bool moveCursor(QPointF pos));
    SLOT(bool sendPointerButton(int button, bool pressed));
    SLOT(bool sendKey(int qtKey, bool pressed));  // qtKey = Qt::Key enum value; server converts to evdev
    // Image capture is asynchronous: the compositor starts the grab and
    // returns immediately; the encoded PNG bytes are delivered via the
    // captureResult signal. This avoids blocking the compositor main thread
    // on GPU read-back.
    SLOT(void captureOutput(QString outputName));
    SLOT(void captureWindow(qint64 id));
    SIGNAL(captureResult(QByteArray data));
    SLOT(QList<DebugEvent> getEvents(quint64 afterSeq));
    SLOT(qint64 focusedWindowId());
    SLOT(qint64 windowUnderCursor());
    // Dumps the underlying QtQuick scene tree (QQuickItem hierarchy) for a
    // window (id != 0) or the whole render window (id == 0) as a pre-formatted
    // text tree: className / objectName / geometry / visible / opacity.
    SLOT(QString getSceneTree(qint64 id));
    PROP(QPointF cursorPosition READONLY)
};
